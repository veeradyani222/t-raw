# Copy to .env and fill in. All optional:
# - leave MT5_* empty to use whatever account the terminal is logged into
# - MT5_PATH: full path to terminal64.exe (ops/bootstrap.ps1 fills it in); blank = auto-detect
# - leave TELEGRAM_* empty for log-only alerts
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# multi-strategy bot (run_live.py): which mix to run and whether to start with
# strategies whose symbol fails the pre-flight switched off (see ops/README.md)
MULTI_MIX_PATH=docs/board/portfolio-lp300-66.json
MULTI_SKIP_UNTRADABLE=
# magic number base; give each mix its own range (e.g. 510000 for round 3) so it never adopts another mix's open trades
MULTI_BASE_MAGIC=
# per-trade risk cap as a fraction; 0.0275 on FundedNext funded accounts (their rule: no trade may risk > 3%)
MULTI_MAX_RISK=
# account size and the prop firm's limits; the daily stop (75% of the daily limit), halt floor and half-size band derive from them
# $5K Stellar Lite: 5000 / 4 / 8   $6K Stellar 2-Step: 6000 / 5 / 10   default: $10K Stellar Lite (10000 / 4 / 8)
MULTI_ACCOUNT_SIZE=
# logins cleared to trade although the broker marks them non-demo (prop challenge accounts report 'real'), comma separated
MULTI_ALLOW_REAL_LOGINS=
MULTI_DAILY_LIMIT_PCT=
MULTI_MAX_LOSS_PCT=
